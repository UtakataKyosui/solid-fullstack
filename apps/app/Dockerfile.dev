# Development Dockerfile - builds and watches on container start
FROM rust:latest

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install watchexec for hot reload (Docker-compatible)
RUN cargo install watchexec-cli

# Set working directory
WORKDIR /app

# Copy entire project (source files will be mounted as volume in docker-compose)
COPY . .

# Expose port
EXPOSE 8000

# Use watchexec to watch for file changes and restart server
CMD ["watchexec", "-r", "-e", "rs,toml", "--", "cargo", "run", "--", "start"]
